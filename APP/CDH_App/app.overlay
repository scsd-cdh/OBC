/ {
};
&ext1_i2c {
	pds_i2c: pds@8 {
		compatible = "vnd,i2c-device";

		reg = < 0x08 >;
	};
	bms_i2c: bms@9 {
		compatible = "vnd,i2c-device";

		reg = < 0x09 >;
	};

};
&spi0 {
	status = "okay";
	cs-gpios = <&pioa 25 GPIO_ACTIVE_LOW>;

	mram: mram@0 {
		compatible = "cdh,mram";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};